# ─── Site ──────────────────────────────────────────────────────────
PORT=3000
# Dossier des données (comptes, réservations, factures). Sur un hébergeur : le disque permanent.
DATA_DIR=data
# Adresse publique du site (sert aux liens dans les e-mails, au sitemap, aux balises SEO)
SITE_URL=https://www.taxi-saint-irenee.fr
# Mettre à 1 derrière un hébergeur HTTPS (cookies sécurisés)
SECURE_COOKIES=1

# ─── Espace chauffeur (/chauffeur) ──────────────────────────────────
# Mot de passe de l'espace chauffeur. Choisissez une phrase longue.
DRIVER_PASSWORD=

# ─── Notifications des nouvelles réservations ──────────────────────
# Notification instantanée sur le téléphone avec l'application gratuite ntfy
# (https://ntfy.sh). Choisissez un nom de sujet long et impossible à deviner.
NTFY_URL=https://ntfy.sh/taxi-saint-irenee-CHANGEZ-MOI
# E-mails (confirmation client, factures, mot de passe oublié) via Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Taxi Saint-Irénée <reservation@taxi-saint-irenee.fr>
# Adresse affichée sur le site et qui reçoit les demandes de réservation
CONTACT_EMAIL=taxisaintirenee@gmail.com
# Destinataire des nouvelles demandes (par défaut : CONTACT_EMAIL)
DRIVER_EMAIL=
# Lien « Laisser un avis » de la fiche Google (sinon, le bouton ouvre un e-mail)
GOOGLE_REVIEW_URL=

# ─── Assistant de l'espace client ───────────────────────────────────
# Clé API Claude (https://console.anthropic.com). Sans clé, l'assistant
# fonctionne quand même avec l'analyse intégrée, en réponses plus simples.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# ─── Mentions légales et factures ───────────────────────────────────
# Forme juridique (ex. : entreprise individuelle, SASU au capital de …)
COMPANY_LEGAL_FORM=
COMPANY_LEGAL_NAME=Taxi Saint-Irénée
# Nom du directeur de la publication (mentions légales) et nom affiché sur les factures.
# Le site n'affiche aucun nom de chauffeur ailleurs. Pour une entreprise individuelle,
# la loi demande le nom de l'exploitant sur les factures et les mentions légales.
COMPANY_DIRECTOR=
COMPANY_OWNER=
COMPANY_ADDRESS=
COMPANY_SIRET=
COMPANY_VAT_NUMBER=
COMPANY_ADS_NUMBER=
COMPANY_CPAM_CONVENTION=
COMPANY_EMAIL=
# Médiateur de la consommation (obligatoire pour les particuliers) : nom et site
COMPANY_MEDIATOR=
# Hébergeur du site : nom, adresse, téléphone
COMPANY_HOST=
# Taux de TVA applicable au transport de voyageurs (10 % en France). 0 si franchise en base.
VAT_RATE=10

# ─── Programme de fidélité ─────────────────────────────────────────
# Nombre de courses (hors transport conventionné) pour obtenir l'avantage
LOYALTY_STEP=10
LOYALTY_REWARD=10 % de remise sur la course suivante

# ─── QR code permanent ──────────────────────────────────────────────
# Adresse imprimée dans le QR code. Laisser vide : elle est fixée automatiquement
# à la première mise en ligne (SITE_URL + /qr) et ne change plus ensuite.
QR_BASE_URL=
